{
    "name": "chunk-lite",
    "version": "0.1.0",
    "description": "Token-aware text chunking for RAG pipelines — configurable overlap, sentence/paragraph-boundary awareness, and a pluggable tokenizer.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "files": [
          "dist"
    ],
    "scripts": {
          "build": "tsup src/index.ts --format cjs,esm --dts",
          "test": "jest",
          "lint": "tsc --noEmit",
          "prepublishOnly": "npm run lint && npm run test && npm run build"
    },
    "keywords": [
          "rag",
          "chunking",
          "text-chunking",
          "embeddings",
          "llm",
          "tokenizer",
          "typescript"
    ],
    "author": "Tejas Kadam",
    "license": "MIT",
    "repository": {
          "type": "git",
          "url": "https://github.com/tejas821/chunk-lite.git"
    },
    "homepage": "https://github.com/tejas821/chunk-lite#readme",
    "bugs": {
          "url": "https://github.com/tejas821/chunk-lite/issues"
    },
    "devDependencies": {
          "@types/jest": "^29.5.12",
          "jest": "^29.7.0",
          "ts-jest": "^29.1.2",
          "tsup": "^8.0.2",
          "typescript": "^5.4.5"
    },
    "engines": {
          "node": ">=16"
    }
}
